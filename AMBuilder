import os

for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  binary = MMSPlugin.HL2Library(builder, cxx, f'{MMSPlugin.metadata["name"]}.{sdk["name"]}', sdk)

  binary.compiler.cxxincludes += [
    os.path.join(builder.sourcePath, 'src'),
    # Needed by the generated *.pb.h (they include <google/protobuf/...>).
    os.path.join(sdk['path'], 'thirdparty', 'protobuf-3.21.8', 'src'),
  ]

  if binary.compiler.target.platform == 'linux':
    binary.compiler.postlink += [
      os.path.join(sdk['path'], 'lib', 'linux64', 'release', 'libprotobuf.a'),
      # Steam symbols (ISteamHTTP) for the Discord webhook; resolved at runtime
      # from the server's own libsteam_api on linux.
      os.path.join(sdk['path'], 'lib', 'linux64', 'libsteam_api.so'),
    ]
  elif binary.compiler.target.platform == 'windows':
    binary.compiler.postlink += [
      os.path.join(sdk['path'], 'lib', 'public', 'win64', '2015', 'libprotobuf.lib'),
      os.path.join(sdk['path'], 'lib', 'public', 'win64', 'steam_api64.lib'),
    ]

  binary.sources += [
    'src/autorestart.cpp',
    'src/discord.cpp',
  ]

  # Only the protos needed for CCSUsrMsg/CUserMessageTextMsg chat output.
  # usermessages.proto -> networkbasetypes.proto -> network_connection.proto
  # (google/protobuf/descriptor.proto is a protoc well-known type, resolved automatically)
  protoc_builder = builder.tools.Protoc(protoc = sdk_target.protoc, sources = [
    os.path.join(sdk['path'], 'common', 'network_connection.proto'),
    os.path.join(sdk['path'], 'common', 'networkbasetypes.proto'),
    os.path.join(sdk['path'], 'game', 'shared', 'usermessages.proto'),
  ])
  protoc_builder.protoc.includes += [
    os.path.join(sdk['path'], 'common'),
    os.path.join(sdk['path'], 'game', 'shared'),
  ]

  binary.custom = [protoc_builder]

  nodes = builder.Add(binary)
  MMSPlugin.binaries += [nodes]
